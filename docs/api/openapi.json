  "components": {
    "schemas": {
      "ActivityView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "action",
          "resource_id",
          "created_at"
        ],
        "title": "ActivityView",
        "description": "Consequential event summary; private audit details are not part of the read contract."
      },
      "CompanyView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "synthetic"
        ],
        "title": "CompanyView",
        "description": "Authorized company identity and the honest synthetic-data disclosure."
      },
      "ConversationDetail": {
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/ConversationView"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "type": "array",
            "title": "Messages"
          },
          "quote": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuoteView"
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery": {
            "items": {
              "$ref": "#/components/schemas/DeliveryView"
            },
            "type": "array",
            "title": "Delivery"
          }
        },
        "type": "object",
        "required": [
          "conversation",
          "messages",
          "quote",
          "delivery"
        ],
        "title": "ConversationDetail",
        "description": "Canonical inbox detail returned after authorization and current membership checks."
      },
      "ConversationView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "company_id": {
            "type": "string",
            "format": "uuid",
            "title": "Company Id"
          },
          "customer_name": {
            "type": "string",
            "title": "Customer Name"
          },
          "customer_company": {
            "type": "string",
            "title": "Customer Company"
          },
          "recipient": {
            "type": "string",
            "title": "Recipient"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "last_customer_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Customer At"
          },
          "preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview"
          }
        },
        "type": "object",
        "required": [
          "id",
          "company_id",
          "customer_name",
          "customer_company",
          "recipient",
          "channel",
          "owner",
          "status",
          "version",
          "created_at",
          "updated_at",
          "last_customer_at"
        ],
        "title": "ConversationView",
        "description": "Staff-visible request state; version is the optimistic mutation precondition."
      },
      "Decision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "decision"
        ],
        "title": "Decision",
        "description": "Staff review command bound to the expected immutable quotation revision."
      },
      "DeliveryView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "error_code",
          "updated_at"
        ],
        "title": "DeliveryView",
        "description": "Durable delivery outcome; provider submission and customer delivery remain distinct."
      },
      "DraftInput": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Selection"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Lines"
          },
          "discount_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Discount Percent",
            "default": "0"
          },
          "shipping": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10000.0,
                "minimum": 0.0
              },
              {
                "type": "string"
