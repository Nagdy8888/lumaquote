  "narrative": {
    "northStar": "The Lighting Sales Desk",
    "overview": "The lighting supplier?s sales desk combines a graphite navigation frame, warm copper actions, and light mineral working surfaces. It feels restrained and practical: dense operational information remains readable while Space Grotesk gives titles and totals a distinct character.\n\nDepth comes mainly from tonal separation and fine borders. The optional procedural lighting scene supplies a controlled presentation moment; the workspace stays usable with its static fallback and reduced motion. Surface-specific composition belongs in docs/UI_DIRECTION.md.",
    "keyCharacteristics": [
      "Graphite framing with mineral working panels.",
      "Warm copper for primary actions and selective emphasis.",
      "Compact, readable information with explicit textual states.",
      "Optional illustrative 3D with a complete static fallback."
    ],
    "rules": [
      {
        "name": "The Textual State Rule",
        "body": "Status color always accompanies a readable state label.",
        "section": "colors"
      },
      {
        "name": "The Two-Face Rule",
        "body": "Space Grotesk carries headings and totals; IBM Plex Sans carries operational reading and controls.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Establish panel hierarchy through tone and borders before adding elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep primary actions copper and working panels light.",
      "Do pair each status color with its truthful textual state.",
      "Do retain visible keyboard focus and meaningful navigation names.",
      "Do preserve the static scene fallback and reduced-motion behavior."
    ],
    "donts": [
      "Don?t make WebGL a requirement for a commercial task.",
      "Don?t present the procedural luminaire as a verified product render.",
      "Don?t replace actual workflow states with decorative success claims."
    ]
  }
}
