{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/python.cjs\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.py\" bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/python.cjs\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.py\" edit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/python.cjs\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.py\" stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
