# Copy provider credentials into .env; never commit populated environment files.
OPENAI_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quotation-assistant

# Local Supabase connection settings are generated into ignored .env.local.
# Backend settings must load .env first, then .env.local for local development.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# These are the only Supabase values intended for the Vite frontend.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
